{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@devflow/shared": ["packages/shared/src/index.ts"],
      "@devflow/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": [
    "src",
    "server.ts",
    "apps/web/src",
    "apps/api/src",
    "packages/shared/src"
  ]
}
